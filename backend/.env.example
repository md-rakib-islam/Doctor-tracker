# ---- Server ----
NODE_ENV=development
PORT=5001

# ---- MongoDB (local mongod, Docker, or MongoDB Atlas connection string) ----
MONGODB_URI=mongodb://127.0.0.1:27017/doctor-tracker

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=8h
COOKIE_NAME=dt_session
# 'lax' when frontend proxies /api (recommended) or shares a site; 'none' (requires HTTPS) for a direct cross-site setup
COOKIE_SAMESITE=lax

# ---- CORS ----
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ---- First admin (used only by `npm run admin:create`) ----
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=
